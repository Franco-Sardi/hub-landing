{
  "redirects": [
    {
      "source": "/proyecto/san-francisco-del-monte-este",
      "destination": "/desarrollos/san-francisco-este",
      "permanent": true
    },
    {
      "source": "/proyecto/san-francisco-del-monte-oeste",
      "destination": "/desarrollos/san-francisco-oeste",
      "permanent": true
    },
    {
      "source": "/proyecto/rodriguez-pena-este",
      "destination": "/desarrollos/rodriguez-pena",
      "permanent": true
    },
    {
      "source": "/proyecto/:slug",
      "destination": "/desarrollos/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
