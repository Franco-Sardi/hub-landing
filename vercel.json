{
  "redirects": [
    {
      "source": "/proyecto/:path*",
      "destination": "/espacios",
      "permanent": true
    },
    {
      "source": "/desarrollos/:path*",
      "destination": "/espacios",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
